<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView style="@style/ScreenIntro" android:text="@string/control_intro" />

        <!-- Estado de la conexión -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvLatency"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/latency_none"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvInvalid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="@string/invalid_frames_zero"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConnect"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/connect" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDisconnect"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/disconnect"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPairSettings"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/pair" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvRoleNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/observer_notice"
            android:textColor="@color/warning"
            android:visibility="gone" />

        <TextView style="@style/SectionLabel" android:text="@string/control_sound_section" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_card" android:orientation="vertical" android:padding="16dp">
        <!-- Efecto de sonido -->
        <TextView
            android:id="@+id/tvEffect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <Spinner
            android:id="@+id/spEffect"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            android:background="@drawable/bg_hero" />

        <!-- Escala rápida (presets de 6 notas) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/preset_label"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <Spinner
            android:id="@+id/spPreset"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            android:background="@drawable/bg_hero" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddPreset"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/preset_add" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditPreset"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/preset_edit" android:visibility="gone" />
        </LinearLayout>

        </LinearLayout>

        <TextView style="@style/SectionLabel" android:text="@string/control_notes_section" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_card" android:orientation="vertical" android:padding="16dp">
        <!-- Botones para asignar notas a cada una de las 6 cuerdas -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/assign_notes_title"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton android:id="@+id/btnNote1" style="@style/NoteAssignBtn" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnNote2" style="@style/NoteAssignBtn" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnNote3" style="@style/NoteAssignBtn" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton android:id="@+id/btnNote4" style="@style/NoteAssignBtn" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnNote5" style="@style/NoteAssignBtn" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnNote6" style="@style/NoteAssignBtn" />
        </LinearLayout>

        </LinearLayout>

        <TextView style="@style/SectionLabel" android:text="@string/control_tools_section" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_card" android:orientation="vertical" android:padding="16dp">
        <!-- Acciones rápidas: Sincronizar / Calibrar LDR / Tono prueba / Audio local -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSync"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/btn_sync"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalibrate"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/btn_calibrate"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestTone"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_test_tone"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swLocalAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/local_audio"
            android:textColor="@color/text_primary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/local_audio_desc"
            android:textColor="@color/text_secondary" android:textSize="13sp" />

        </LinearLayout>

        <TextView style="@style/SectionLabel" android:text="@string/control_live_section" />

        <!-- Visualización de las 6 cuerdas láser -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/strings_title"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:padding="6dp">

            <LinearLayout style="@style/StringColumn">
                <TextView android:id="@+id/count1" style="@style/StringCount" />
                <View android:id="@+id/string1" style="@style/LaserString" />
                <TextView android:id="@+id/label1" style="@style/StringLabel" />
            </LinearLayout>

            <LinearLayout style="@style/StringColumn">
                <TextView android:id="@+id/count2" style="@style/StringCount" />
                <View android:id="@+id/string2" style="@style/LaserString" />
                <TextView android:id="@+id/label2" style="@style/StringLabel" />
            </LinearLayout>

            <LinearLayout style="@style/StringColumn">
                <TextView android:id="@+id/count3" style="@style/StringCount" />
                <View android:id="@+id/string3" style="@style/LaserString" />
                <TextView android:id="@+id/label3" style="@style/StringLabel" />
            </LinearLayout>

            <LinearLayout style="@style/StringColumn">
                <TextView android:id="@+id/count4" style="@style/StringCount" />
                <View android:id="@+id/string4" style="@style/LaserString" />
                <TextView android:id="@+id/label4" style="@style/StringLabel" />
            </LinearLayout>

            <LinearLayout style="@style/StringColumn">
                <TextView android:id="@+id/count5" style="@style/StringCount" />
                <View android:id="@+id/string5" style="@style/LaserString" />
                <TextView android:id="@+id/label5" style="@style/StringLabel" />
            </LinearLayout>

            <LinearLayout style="@style/StringColumn">
                <TextView android:id="@+id/count6" style="@style/StringCount" />
                <View android:id="@+id/string6" style="@style/LaserString" />
                <TextView android:id="@+id/label6" style="@style/StringLabel" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvLastNote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/last_note_none"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetCounters"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reset_counters" />
        </LinearLayout>

        <!-- Bitácora de comunicación -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/comm_log"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_card"
            android:fontFamily="monospace"
            android:minHeight="110dp"
            android:padding="10dp"
            android:textColor="@color/laser_green"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
